---
import "@/styles/global.css";
import { Icon } from "astro-icon/components";           
import { ModeToggle } from "@/components/ModeToggle";   
interface Props { title?: string; description?: string }
const { title = "Tom Martin", description = "Data science, statistics and the tools I build." } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname;
const url = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL("/og.png", Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />


<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  }
</script>
</head>
<body class="flex min-h-screen flex-col">
<header class="border-b">
<nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
<a href="/" class="hidden font-mono text-sm font-medium sm:block">thomasmartin.id.au</a>


<div class="flex items-center gap-6">
<ul class="flex gap-6 text-sm">
{nav.map((l) => {
const active = l.href === "/" ? path === "/" : path.startsWith(l.href);
return (
<li>
<a href={l.href} class:list={["hover:text-foreground", active ? "text-foreground" : "text-muted-foreground"]}>
{l.label}
</a>
</li>
            );
          })}
</ul>


<div class="flex items-center gap-2">
<a href="https://github.com/gippers" aria-label="GitHub"
   class="inline-flex size-9 items-center justify-center border text-muted-foreground hover:bg-muted hover:text-foreground">
<Icon name="simple-icons:github" class="size-4" />
</a>
<ModeToggle client:load />
</div>
</div>

</nav>
</header>
<main class="flex-1"><slot /></main>
<footer class="border-t">
<div class="mx-auto max-w-5xl px-4 py-6 text-sm text-muted-foreground">© {new Date().getFullYear()} Tom Martin</div>
</footer>
</body>
</html>