---
import "@/styles/global.css";
interface Props { title?: string; description?: string }
const { title = "Tom Martin", description = "Data science, statistics and the tools I build." } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b">
      <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
        <a href="/" class="font-mono text-sm font-medium">thomasmartin.id.au</a>
        <ul class="flex gap-6 text-sm">
          {nav.map((l) => {
            const active = l.href === "/" ? path === "/" : path.startsWith(l.href);
            return (
              <li>
                <a href={l.href} class:list={["hover:text-foreground", active ? "text-foreground" : "text-muted-foreground"]}>
                  {l.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>
    <main class="flex-1"><slot /></main>
    <footer class="border-t">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-muted-foreground">© {new Date().getFullYear()} Tom Martin</div>
    </footer>
  </body>
</html>