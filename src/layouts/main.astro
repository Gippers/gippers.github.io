---
import "@/styles/global.css";
import { ModeToggle } from "@/components/ModeToggle";
import { sections } from "@/data";
interface Props { title?: string; description?: string }
const { title = "Site name", description = "A short description of this site." } = Astro.props;
const nav = [
  { href: "/", label: "Home" },
  { href: "/data-professionals/", label: "Data Professionals" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname;
const url = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />


<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  }
</script>
</head>
<body class="flex min-h-screen flex-col">
<header class="border-b">
<nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
<a href="/" class="hidden font-mono text-sm font-medium sm:block">Site name</a>


<div class="flex items-center gap-3 sm:gap-6">
<ul class="flex gap-3 text-sm whitespace-nowrap sm:gap-6">
{nav.map((l) => {
const active = l.href === "/" ? path === "/" : path.startsWith(l.href);
return (
<li>
<a href={l.href} class:list={["hover:text-foreground", active ? "text-foreground" : "text-muted-foreground"]}>
{l.label}
</a>
</li>
            );
          })}
</ul>


<div class="flex items-center gap-2">
<ModeToggle client:load />
</div>
</div>

</nav>
</header>
<main class="flex-1"><slot /></main>
<footer class="border-t">
<div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-8 px-4 py-10 text-sm">
<div class="space-y-3">
<a href="/data-professionals/" class="block font-medium hover:underline">Data Professionals</a>
<ul class="space-y-2 text-muted-foreground">
{sections.map((s) => <li><a href={`/data-professionals/${s.slug}/`} class="hover:text-foreground">{s.title}</a></li>)}
</ul>
</div>
<ul class="space-y-2 text-muted-foreground sm:text-right">
<li><a href="/projects/" class="hover:text-foreground">Projects</a></li>
<li><a href="/about/" class="hover:text-foreground">About</a></li>
</ul>
</div>
</footer>
</body>
</html>