---
import Main from "@/layouts/main.astro";
import EducationCard from "@/components/EducationCard.astro";
import { education, email } from "@/data";
---
<Main title="About · Tom Martin">
  <div class="mx-auto max-w-3xl space-y-12 px-4 py-12">
    <section class="space-y-4">
      <h1 class="text-3xl font-semibold tracking-tight">About</h1>
      <p class="text-muted-foreground">I am an accomplished data professional with over five years of
        experience working with data in industry. I am passionate about delivering actionable
        analytical insights that inform and drive improved policy and outcomes. I have worked with
        all stages of the analysis process including synthesising research questions from business
        requirements, extracting and cleaning complex administrative data, conducting statistical
        analysis and modelling, and presenting results in an easily comprehensible format.</p>
    </section>

    <section class="space-y-4">
      <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Education</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {education.map((e) => <EducationCard item={e} />)}
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Professional experience</h2>
      <p class="text-muted-foreground">Over five years of industry experience in data analytics and
        data science, including building BI tools, wrangling data, data modelling (regression and
        forecasting), and collating results into reports.</p>
    </section>

    <section class="space-y-2">
      <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Contact</h2>
      <p class="text-muted-foreground">
        Email <a href={`mailto:${email}`} class="text-foreground underline-offset-4 hover:underline">{email}</a>,
        or see my code on <a href="https://github.com/gippers" target="_blank" rel="noopener noreferrer" class="text-foreground underline-offset-4 hover:underline">GitHub</a>.
      </p>
    </section>
  </div>
</Main>
