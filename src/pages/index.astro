---
import Main from "@/layouts/main.astro";
import CharGrid from "@/components/CharGrid.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import EducationCard from "@/components/EducationCard.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { projects, education, email } from "@/data";
const featured = projects.find((p) => p.featured)!;
---
<Main>
  <section class="relative grid min-h-[40vh] place-items-center overflow-hidden border-b">
    <CharGrid />
    <div class="relative border bg-background/85 p-8 text-center">
      <h1 class="text-4xl font-semibold tracking-tight">Tom Martin</h1>
      <p class="mt-2 font-mono text-xs text-muted-foreground">Statistician · Computer Scientist · Data Analyst</p>
      <p class="mt-4 max-w-md text-muted-foreground">I build statistical models and BI tools, and apply statistics to help organisations make better decisions.</p>
    </div>
  </section>

  <div class="mx-auto max-w-5xl space-y-16 px-4 py-16">
    <section class="grid gap-8 md:grid-cols-[1fr_1.2fr] md:items-center">
      <div class="space-y-4">
        <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Featured project</h2>
        <p class="text-muted-foreground">Applied data analysis projects in R and Python. One I'd highlight is the {featured.title}: {featured.description.toLowerCase()}</p>
        <a href="/projects/" class={cn(buttonVariants({ variant: "outline" }))}>View all projects</a>
      </div>
      <ProjectCard project={featured} />
    </section>

    <section class="space-y-6">
      <div class="flex items-baseline justify-between">
        <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Qualifications</h2>
        <a href="/about/" class="text-xs text-muted-foreground hover:text-foreground">More about me →</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {education.map((e) => <EducationCard item={e} />)}
      </div>
    </section>

    <section class="space-y-2">
      <h2 class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Get in touch</h2>
      <a href={`mailto:${email}`} class="text-lg underline-offset-4 hover:underline">{email}</a>
    </section>
  </div>
</Main>
