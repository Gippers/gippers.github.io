---
import Main from "@/layouts/main.astro";
import CharGrid from "@/components/CharGrid.astro";
import { Card, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { sections } from "@/data";
---
<Main>
  <section class="relative overflow-hidden border-b">
    <CharGrid />
    <div class="relative mx-auto max-w-5xl px-4 py-20 sm:py-28">
      <div class="max-w-xl border bg-background/85 p-8 sm:p-10">
        <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Tagline goes here</p>
        <h1 class="mt-4 text-5xl font-semibold tracking-tight sm:text-6xl">Site name</h1>
        <p class="mt-4 text-lg text-muted-foreground">A sentence or two about what this site is for.</p>
        <div class="mt-8 flex flex-wrap gap-2">
          <a href="/data-professionals/" class={cn(buttonVariants({ size: "lg" }))}>Data Professionals</a>
          <a href="/projects/" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>Projects</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="mb-6 font-mono text-xs uppercase tracking-widest text-muted-foreground">For data professionals</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      {sections.map((s) => (
        <a href={`/data-professionals/${s.slug}/`} class="group">
          <Card className="h-full transition-colors group-hover:ring-foreground/30">
            <CardHeader>
              <CardTitle className="text-base">{s.title}</CardTitle>
              <CardDescription>{s.description}</CardDescription>
            </CardHeader>
          </Card>
        </a>
      ))}
    </div>
  </section>
</Main>
