---
import Main from "@/layouts/main.astro";
import CharGrid from "@/components/CharGrid.astro";
---
<Main>
  <section class="relative grid min-h-[60vh] place-items-center overflow-hidden border-b">
    <CharGrid />
    <div class="relative border bg-background/85 p-8 text-center">
      <h1 class="text-4xl font-semibold tracking-tight">Tom Martin</h1>
      <p class="mt-2 text-muted-foreground">Data science, statistics and the tools I build along the way.</p>
    </div>
  </section>
</Main>