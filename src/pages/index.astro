---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import CharGrid from '../components/CharGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <section class="hero">
      <CharGrid />
      <div class="hero-content">
        <h1>Tom Martin</h1>
        <p>Data science, statistics and the tools I build along the way.</p>
      </div>
    </section>

    <main>
      <h2>Projects</h2>
      <p>Coming soon.</p>
    </main>

    <Footer />
  </body>
</html>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 60vh;
    display: grid;
    place-items: center;
    border-bottom: 1px solid rgb(var(--gray-light));
  }
  .hero-content {
    position: relative;          /* sits above the canvas */
    text-align: center;
    padding: 2rem;
    background: rgb(var(--gray-gradient, 255 255 255) / 0.85);
    border: 1px solid rgb(var(--gray-light));
  }
  .hero-content h1 { margin: 0 0 0.5rem; }
  .hero-content p { margin: 0; }
</style>