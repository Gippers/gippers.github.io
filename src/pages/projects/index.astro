---
import Main from "@/layouts/main.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data";
---
<Main title="Projects · Tom Martin">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>
    <p class="mt-2 mb-8 text-muted-foreground">Applied data analysis in R and Python. Each project opens on its own site.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Main>
