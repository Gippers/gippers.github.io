---
import Main from "@/layouts/main.astro";
import { ArrowUpRight, Search } from "lucide-react";
import { projects } from "@/data";
---
<Main title="Projects">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>
        <p class="mt-2 text-muted-foreground">A short introduction to these projects.</p>
      </div>
      <label class="relative w-full sm:w-64">
        <span class="sr-only">Search projects</span>
        <Search className="pointer-events-none absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-muted-foreground" />
        <input id="project-search" type="search" placeholder="Search projects or tags…"
          class="h-8 w-full rounded-none border border-input bg-transparent pr-2.5 pl-8 text-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-1 focus-visible:ring-ring/50 dark:bg-input/30" />
      </label>
    </div>

    <ul id="project-list" class="divide-y border-y">
      {projects.map((p) => (
        <li data-search={[p.title, p.description, ...p.tags].join(" ").toLowerCase()}>
          <a href={p.url} target="_blank" rel="noopener noreferrer"
            class:list={["group grid gap-4 py-6 transition-colors hover:bg-muted/50 sm:gap-6 sm:px-4", p.image && "sm:grid-cols-[16rem_1fr]"]}>
            {p.image && <img src={p.image} alt="" loading="lazy" class="aspect-[16/9] w-full border bg-white object-cover" />}
            <div class="flex flex-col gap-2">
              <div class="flex items-start justify-between gap-2">
                <h2 class="text-lg font-medium">{p.title}</h2>
                <ArrowUpRight className="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-foreground" />
              </div>
              <p class="text-sm text-muted-foreground">{p.description}</p>
              <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-2">
                {p.tags.map((t) => <span class="border px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">{t}</span>)}
                <span class="ml-auto font-mono text-[10px] text-muted-foreground">{p.date.toLocaleDateString("en-AU", { month: "short", year: "numeric" })}</span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p id="project-empty" hidden class="py-12 text-center text-sm text-muted-foreground">No projects match your search.</p>
  </section>
</Main>

<script>
  const input = document.getElementById("project-search") as HTMLInputElement;
  const items = document.querySelectorAll<HTMLElement>("#project-list > li");
  const empty = document.getElementById("project-empty")!;
  input.addEventListener("input", () => {
    // every typed word must start a word in the title, description or tags ("act" shouldn't match "interactive")
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    items.forEach((li) => {
      const text = li.dataset.search!.split(/\W+/);
      li.hidden = !words.every((w) => text.some((t) => t.startsWith(w)));
      if (!li.hidden) shown++;
    });
    empty.hidden = shown > 0;
  });
</script>
