---
import { Icon } from "astro-icon/components"
import { skills, methods } from "@/data"
---
<section aria-label="Skills and tools" class="skill-ticker space-y-3 border-t py-4">
  {[skills, methods].map((row, r) => (
    <div class="fade overflow-hidden">
      <div class:list={["track flex w-max", r === 1 && "reverse"]}>
        {[0, 1, 2, 3].map((copy) => (
          <ul class="flex shrink-0" aria-hidden={copy > 0 ? "true" : undefined}>
            {row.map(({ name, icon: I }) => (
              <li class="flex items-center gap-2 px-6 font-mono text-xs whitespace-nowrap text-muted-foreground">
                {typeof I === "string" ? <Icon name={I} class="size-4" /> : <I className="size-4" />}
                {name}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  /* four identical lists (one copy is narrower than wide screens); sliding by one copy loops seamlessly */
  .track { animation: ticker 60s linear infinite; }
  .track.reverse { animation-direction: reverse; }
  .skill-ticker:hover .track { animation-play-state: paused; }
  @keyframes ticker { to { transform: translateX(-25%); } }
  .fade { mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent); }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .skill-ticker ul[aria-hidden] { display: none; }
    .skill-ticker ul { flex-wrap: wrap; justify-content: center; row-gap: 0.75rem; }
  }
</style>
