---
// src/components/CharGrid.astro
interface Props { cell?: number; radius?: number }
const { cell = 16, radius = 90 } = Astro.props;
---
<canvas class="char-grid" aria-hidden="true" data-cell={cell} data-radius={radius}></canvas>

<style>
  .char-grid {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none;
    --grid-dim: var(--muted-foreground);  /* colour as a cell starts to appear */
    --grid-hot: var(--primary);           /* colour at full brightness */
  }
</style>

<script>
  const CHARS = "0123456789ABCDEFGHJKLMNPQRSTUVWXYZ#%&*+=<>/";

  // Cursor trail
  const HIT_CHANCE = 0.02;        // chance a nearby cell lights per pointer sample
  const FADE_IN = 0.08;           // seconds (time constant) to fade in
  const QUICK_FADE = 1.2;         // seconds for a normal lit cell to fade out
  const LINGER_CHANCE = 0.12;     // chance a lit cell lingers instead
  const LINGER_MIN = 5;           // seconds
  const LINGER_MAX = 30;          // seconds
  const SCRAMBLE = 0.8;           // flickers per second for quick cells
  const LINGER_SCRAMBLE = 0.08;   // flickers per second for lingering cells (calmer)

  // Ambient layer (runs without the cursor)
  const AMBIENT_DENSITY = 0.1;  // fraction of cells mid-fade at any time (sparse)
  const AMBIENT_MIN = 40;         // seconds per fade in + out cycle
  const AMBIENT_MAX = 60;
  const AMBIENT_PEAK_MIN = 0.2;   // max opacity an ambient cell reaches
  const AMBIENT_PEAK_MAX = 0.5;

  const BASE = 0;                 // resting opacity for every cell; try 0.03 for a faint full grid

  const rand = () => CHARS[(Math.random() * CHARS.length) | 0];
  const between = (a: number, b: number) => a + Math.random() * (b - a);

  document.querySelectorAll<HTMLCanvasElement>(".char-grid").forEach((canvas) => {
    const ctx = canvas.getContext("2d")!;
    const host = canvas.parentElement!;
    const CELL = Number(canvas.dataset.cell) || 16;
    const RADIUS = Number(canvas.dataset.radius) || 90;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let w = 0, h = 0, cols = 0, rows = 0;
    let chars: string[] = [];
    let heat = new Float32Array(0);    // trail target brightness, falls linearly
    let glow = new Float32Array(0);    // trail drawn brightness, eases toward heat
    let fadeDur = new Float32Array(0); // per-cell fade-out time in seconds
    let ambT = new Float32Array(0);    // ambient elapsed time, -1 = inactive
    let ambDur = new Float32Array(0);
    let ambPeak = new Float32Array(0);
    let ambActive = 0;
    let dim = "#888", hot = "#888";
    let prevPt: { x: number; y: number } | null = null;

    function readColors() {
      const s = getComputedStyle(canvas);
      dim = s.getPropertyValue("--grid-dim").trim() || dim;
      hot = s.getPropertyValue("--grid-hot").trim() || hot;
    }

    function spawnAmbient(randomPhase: boolean) {
      for (let tries = 0; tries < 10; tries++) {
        const i = (Math.random() * ambT.length) | 0;
        if (ambT[i] >= 0) continue;
        ambDur[i] = between(AMBIENT_MIN, AMBIENT_MAX);
        ambPeak[i] = between(AMBIENT_PEAK_MIN, AMBIENT_PEAK_MAX);
        ambT[i] = randomPhase ? Math.random() * ambDur[i] : 0;
        if (glow[i] < 0.05) chars[i] = rand();
        ambActive++;
        return;
      }
    }

    function topUpAmbient(randomPhase: boolean) {
      const target = Math.round(ambT.length * AMBIENT_DENSITY);
      for (let guard = 0; ambActive < target && guard < target * 3; guard++) spawnAmbient(randomPhase);
    }

    function ambient(i: number) {
      if (ambT[i] < 0) return 0;
      const s = Math.sin((Math.PI * ambT[i]) / ambDur[i]);
      return ambPeak[i] * s * s; // smooth in, smooth out
    }

    function resize() {
      const dpr = devicePixelRatio || 1;
      w = host.clientWidth; h = host.clientHeight;
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(w / CELL); rows = Math.ceil(h / CELL);
      const n = cols * rows;
      chars = Array.from({ length: n }, rand);
      heat = new Float32Array(n);
      glow = new Float32Array(n);
      fadeDur = new Float32Array(n).fill(QUICK_FADE);
      ambT = new Float32Array(n).fill(-1);
      ambDur = new Float32Array(n);
      ambPeak = new Float32Array(n);
      ambActive = 0;
      topUpAmbient(true); // start mid-cycle so the page is never empty
      readColors();
      draw();
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      ctx.font = `${Math.round(CELL * 0.75)}px ui-monospace, "SFMono-Regular", Menlo, monospace`;
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      for (let i = 0; i < glow.length; i++) {
        const g = Math.max(glow[i], ambient(i), BASE);
        if (g < 0.01) continue;
        const x = (i % cols) * CELL + CELL / 2;
        const y = ((i / cols) | 0) * CELL + CELL / 2;
        ctx.globalAlpha = g;     ctx.fillStyle = dim; ctx.fillText(chars[i], x, y);
        ctx.globalAlpha = g * g; ctx.fillStyle = hot; ctx.fillText(chars[i], x, y);
      }
      ctx.globalAlpha = 1;
    }

    function step(dt: number) {
      const kIn = 1 - Math.exp(-dt / FADE_IN);
      for (let i = 0; i < heat.length; i++) {
        if (ambT[i] >= 0) {
          ambT[i] += dt;
          if (ambT[i] >= ambDur[i]) { ambT[i] = -1; ambActive--; }
        }
        if (heat[i] > 0 || glow[i] > 0.002) {
          heat[i] = Math.max(0, heat[i] - dt / fadeDur[i]);
          glow[i] += (heat[i] - glow[i]) * kIn;
          if (heat[i] === 0 && glow[i] < 0.002) glow[i] = 0;
          const rate = fadeDur[i] > QUICK_FADE ? LINGER_SCRAMBLE : SCRAMBLE;
          if (glow[i] > 0.3 && Math.random() < rate * dt) chars[i] = rand();
        }
      }
      topUpAmbient(false);
      draw();
    }

    function hit(px: number, py: number) {
      const c0 = Math.max(0, Math.floor((px - RADIUS) / CELL));
      const c1 = Math.min(cols - 1, Math.floor((px + RADIUS) / CELL));
      const r0 = Math.max(0, Math.floor((py - RADIUS) / CELL));
      const r1 = Math.min(rows - 1, Math.floor((py + RADIUS) / CELL));
      for (let r = r0; r <= r1; r++) for (let c = c0; c <= c1; c++) {
        const d = Math.hypot(c * CELL + CELL / 2 - px, r * CELL + CELL / 2 - py);
        if (d > RADIUS || Math.random() > HIT_CHANCE * (1 - d / RADIUS)) continue;
        const i = r * cols + c;
        if (heat[i] < 0.25) {
          chars[i] = rand(); // returning to a faded cell gives a new character
          fadeDur[i] = Math.random() < LINGER_CHANCE ? between(LINGER_MIN, LINGER_MAX) : QUICK_FADE;
        }
        heat[i] = 1;
      }
    }

    // Animation loop: runs only while the grid is on screen
    let raf = 0, lastT = 0, visible = false;
    function frame(now: number) {
      raf = 0;
      const dt = Math.min(0.1, (now - lastT) / 1000); // clamp after tab switches
      lastT = now;
      step(dt);
      if (visible) raf = requestAnimationFrame(frame);
    }
    function start() {
      if (raf) return;
      lastT = performance.now();
      raf = requestAnimationFrame(frame);
    }

    new ResizeObserver(resize).observe(host);

    if (!reduce) {
      host.addEventListener("pointermove", (e) => {
        const b = host.getBoundingClientRect();
        const p = { x: e.clientX - b.left, y: e.clientY - b.top };
        if (prevPt) { // fill gaps on fast swipes
          const dist = Math.hypot(p.x - prevPt.x, p.y - prevPt.y);
          const steps = Math.min(12, Math.floor(dist / (RADIUS / 2)));
          for (let s = 1; s <= steps; s++) {
            const t = s / (steps + 1);
            hit(prevPt.x + (p.x - prevPt.x) * t, prevPt.y + (p.y - prevPt.y) * t);
          }
        }
        hit(p.x, p.y);
        prevPt = p;
      });
      host.addEventListener("pointerleave", () => { prevPt = null; });

      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible) start();
      }).observe(canvas);
    }
    // With reduced motion: the ambient cells are drawn once at random points in their cycle and stay still.

    const recolour = () => { readColors(); draw(); };
    new MutationObserver(recolour).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", recolour);
  });
</script>