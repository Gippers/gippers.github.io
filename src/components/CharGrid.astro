---
// src/components/CharGrid.astro
---
<canvas class="char-grid" aria-hidden="true"></canvas>

<style>
  .char-grid { position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none; color: var(--accent, currentColor); }
</style>

<script>
  const CHARS = " .:-=+*#%@";            // light → dense
  const CELL = 14, RADIUS = 140;         // px per cell, cursor influence

  document.querySelectorAll<HTMLCanvasElement>(".char-grid").forEach((canvas) => {
    const ctx = canvas.getContext("2d")!;
    const host = canvas.parentElement!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const color = getComputedStyle(canvas).color;
    let w = 0, h = 0, cols = 0, rows = 0, mx = -1e4, my = -1e4, t = 0, running = false;

    function resize() {
      const dpr = devicePixelRatio || 1;
      w = host.clientWidth; h = host.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = `${CELL - 2}px ui-monospace, monospace`;
      ctx.textBaseline = "top";
      cols = Math.ceil(w / CELL); rows = Math.ceil(h / CELL);
      draw();
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = color;
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
        const x = c * CELL, y = r * CELL;
        const near = Math.max(0, 1 - Math.hypot(x - mx, y - my) / RADIUS);
        const wave = reduce ? 0 : 0.15 * (Math.sin(c * 0.3 + t) + Math.cos(r * 0.4 - t * 0.8));
        const v = Math.min(1, Math.max(0, 0.15 + wave + near));
        ctx.globalAlpha = 0.15 + v * 0.85;
        ctx.fillText(CHARS[Math.floor(v * (CHARS.length - 1))], x, y);
      }
    }

    function loop() { t += 0.03; draw(); if (running) requestAnimationFrame(loop); }

    host.addEventListener("pointermove", (e) => {
      const b = host.getBoundingClientRect();
      mx = e.clientX - b.left; my = e.clientY - b.top;
      if (reduce) draw();
    });
    host.addEventListener("pointerleave", () => { mx = my = -1e4; if (reduce) draw(); });

    new ResizeObserver(resize).observe(host);
    if (!reduce) new IntersectionObserver(([e]) => {
      const was = running; running = e.isIntersecting;
      if (running && !was) loop();
    }).observe(canvas);
  });
</script>