---
import { ArrowUpRight } from "lucide-react"
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card"
import type { projects } from "@/data"

interface Props { project: (typeof projects)[number] }
const { project: p } = Astro.props
---
<a href={p.url} target="_blank" rel="noopener noreferrer" class="group block h-full">
  <Card className="h-full transition-colors group-hover:ring-foreground/30">
    <img src={p.image} alt="" loading="lazy"
      class="aspect-[16/9] w-full border-b bg-white object-cover" />
    <CardHeader>
      <div class="flex items-start justify-between gap-2">
        <CardTitle className="text-base">{p.title}</CardTitle>
        <ArrowUpRight className="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-foreground" />
      </div>
      <CardDescription>{p.description}</CardDescription>
    </CardHeader>
    <CardContent className="mt-auto flex flex-wrap items-center gap-1.5">
      {p.tags.map((t) => <span class="border px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">{t}</span>)}
      <span class="ml-auto font-mono text-[10px] text-muted-foreground">{p.date.getFullYear()}</span>
    </CardContent>
  </Card>
</a>
