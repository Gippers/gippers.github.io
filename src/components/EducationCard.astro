---
import { GraduationCap } from "lucide-react"
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/card"
import type { education } from "@/data"

interface Props { item: (typeof education)[number] }
const { item: e } = Astro.props
---
<Card className="h-full">
  <CardHeader>
    <div class="flex items-center justify-between gap-2">
      <GraduationCap className="size-4 text-muted-foreground" />
      {e.ongoing && <span class="border border-primary px-1.5 py-0.5 font-mono text-[10px] text-primary">In progress</span>}
    </div>
    <CardTitle className="mt-2 text-base">{e.degree}</CardTitle>
    <CardDescription>{e.school}</CardDescription>
  </CardHeader>
  <CardContent className="mt-auto space-y-1">
    {e.detail && <p class="text-muted-foreground">{e.detail}</p>}
    <p class="font-mono text-[10px] text-muted-foreground">{e.dates}</p>
  </CardContent>
</Card>
